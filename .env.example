# Copy this file to .env.development (or .env.test) and fill in real values.
# In production (Vercel) these are set via the dashboard, not a file.

NODE_ENV=
PORT=
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=
MAX_FILE_SIZE_MB=
LOG_LEVEL=

# Comma-separated browser origins allowed to call the API, e.g.
# https://app.example.com,http://localhost:5173
# Leave empty to allow no browser origins. Postman/curl are unaffected either way.
CORS_ORIGINS=

# Rate limiting. Defaults: 15 min window, 100 requests per IP, 10 on auth routes.
RATE_LIMIT_WINDOW_MINUTES=
RATE_LIMIT_MAX_REQUESTS=
AUTH_RATE_LIMIT_MAX_REQUESTS=

# Soft delete retention. The purge cron hard-deletes items and destroys their
# Cloudinary assets once they have been deleted for longer than this.
MEDIA_RETENTION_DAYS=
MEDIA_PURGE_BATCH_LIMIT=

# Vercel sends this as a Bearer token when it triggers the cron. Min 16 chars.
# Without it the purge endpoint rejects everything.
CRON_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
