NODE_ENV=test
PORT=3000
DATABASE_URL=mongodb://localhost:27017/media-library-test
JWT_SECRET=test-secret-that-is-at-least-16-characters-long
JWT_EXPIRES_IN=7d
MAX_FILE_SIZE_MB=5
LOG_LEVEL=silent

# Deliberately low so the 429 path is cheap to exercise. Counters reset between
# cases (see tests/setup/mongo.ts), so this can't bleed into unrelated tests.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5
CORS_ORIGINS=https://app.test.local
CLOUDINARY_CLOUD_NAME=fake-cloud
CLOUDINARY_API_KEY=fake-key
CLOUDINARY_API_SECRET=fake-secret
