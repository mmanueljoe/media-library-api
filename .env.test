# Copy this file to .env.development (or .env.test) and fill in real values.
# In production (Vercel) these are set via the dashboard, not a file.

NODE_ENV=test
PORT=3000
DATABASE_URL=mongodb://placeholder/test
JWT_SECRET=3d64c48b1961a78c33685ad584c660da2f47440b53735ba961ec240cbc828efc7853e39a00fc332d77a69dec44d270910855f5b5e9f67bd5731c187716d77b63
JWT_EXPIRES_IN=7d
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=upload
LOG_LEVEL=error

# Cloudinary — required by env.ts, but irrelevant for tests because
# the SDK is mocked in tests/setup/setup.ts. Any non-empty values work.
CLOUDINARY_CLOUD_NAME=test
CLOUDINARY_API_KEY=test
CLOUDINARY_API_SECRET=test
